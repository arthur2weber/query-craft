# EditorConfig for QueryCraft
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[composer.json]
indent_size = 4

[*.php]
indent_style = space
indent_size = 4
max_line_length = 120
